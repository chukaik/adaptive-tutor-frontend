# Copy this file to .env.local (already git-ignored) and adjust as needed.
# Expo reads EXPO_PUBLIC_* variables at build time and puts them in the app
# bundle, so never put secrets here.

# Base URL of the AdaptiveTutor FastAPI backend, without a trailing slash.
# For a backend running on your machine use e.g. http://localhost:8000
EXPO_PUBLIC_API_URL=https://adaptive-tutor-api.onrender.com
